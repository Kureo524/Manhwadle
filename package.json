{
  "name": "manhwadle",
  "productName": "Manhwadle",
  "version": "0.1.0",
  "description": "Jeu de déduction de personnages de manhwa",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "fetch-images": "node tools/fetch-images.mjs",
    "dist": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "dev.kureo.manhwadle",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "data/**",
      "assets/**"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Game"
    }
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@38.8.6": true
  }
}
