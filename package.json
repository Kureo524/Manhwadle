{
  "name": "manhwadle",
  "productName": "Manhwadle",
  "version": "0.1.1",
  "description": "Jeu de déduction de personnages de manhwa",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/logic.test.js",
    "dist": "electron-builder --linux AppImage",
    "portraits:galerie": "node tools/portraits.mjs galerie",
    "portraits:import": "node tools/portraits.mjs import",
    "site": "node tools/build-site.mjs"
  },
  "build": {
    "appId": "dev.kureo.manhwadle",
    "files": [
      "main.js",
      "preload.js",
      "data-loader.js",
      "window-fit.js",
      "share-image.js",
      "src/**",
      "data/**",
      "assets/**"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Game"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    }
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@45.2.2": true
  }
}
